# Somnia Perps Deployment ("hideki" = Tokyo Testnet Chain 50383, "testnet" = Shannon Chain 50312)
NETWORK=hideki

# Optional: Override RPC / WS / Indexer endpoints
# RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# WS_RPC_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql

# Optional: Signer private key (0x...) for live order submission.
# Leave unset to run in read-only + live testnet analytics + simulation mode.
PRIVATE_KEY=

# Optional: Main DreamDEX account address (0x...) when PRIVATE_KEY is a linked bot trading key.
OWNER_ADDRESS=

# Strategy Parameters
SENTINEL_SLICE_USDSO=50
SENTINEL_MAX_POSITION_USDSO=200
SENTINEL_ENTER_APR_PCT=20
SENTINEL_EXIT_APR_PCT=5
SENTINEL_LEVERAGE=5
SENTINEL_WARN_HEALTH_RATIO=1.5
SENTINEL_EMERGENCY_HEALTH_RATIO=1.2
SENTINEL_DRY_RUN=true
